@model IEnumerable<HastaneRandevuSistemi.Models.Duyuru>
@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="hero-section">
    <div class="container">
        <h1 class="hero-title">Sağlığınız İçin Buradayız</h1>
        <p class="hero-subtitle">Uzman doktor kadromuz ve modern teknolojimizle hizmetinizdeyiz.</p>

        @if (Context.Session.GetString("HastaKullaniciAdi") == null)
        {
            <a asp-controller="Account" asp-action="Register" class="btn btn-danger btn-lg px-5 py-3 fw-bold rounded-pill shadow">
                <i class="fas fa-user-plus"></i> Hemen Kayıt Ol
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg px-5 py-3 fw-bold rounded-pill ms-2">
                Giriş Yap
            </a>
        }
        else
        {
            <a asp-controller="Randevu" asp-action="RandevuAl" class="btn btn-success btn-lg px-5 py-3 fw-bold rounded-pill shadow">
                <i class="fas fa-calendar-check"></i> Hemen Randevu Al
            </a>
        }
    </div>
</div>

<div class="container mb-5">
    <div class="row text-center mb-5 mt-n5">
        <div class="col-md-4 mb-4">
            <div class="card feature-card shadow h-100 py-4">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-user-md"></i></div>
                    <h4 class="card-title fw-bold">Uzman Doktorlar</h4>
                    <p class="card-text text-muted">Alanında deneyimli hekimlerimizle en doğru teşhis ve tedavi.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card feature-card shadow h-100 py-4">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-clock"></i></div>
                    <h4 class="card-title fw-bold">7/24 Hizmet</h4>
                    <p class="card-text text-muted">Acil servisimiz ve online randevu sistemimizle her an yanınızdayız.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card feature-card shadow h-100 py-4">
                <div class="card-body">
                    <div class="icon-box"><i class="fas fa-microscope"></i></div>
                    <h4 class="card-title fw-bold">Modern Laboratuvar</h4>
                    <p class="card-text text-muted">Son teknoloji cihazlarla hızlı ve güvenilir tahlil sonuçları.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h3 class="fw-bold text-dark"><i class="fas fa-bullhorn text-warning"></i> Güncel Duyurular</h3>
                </div>
                <div class="card-body px-4 pb-4">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-light text-center">Şu anda güncel bir duyuru bulunmamaktadır.</div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var duyuru in Model)
                            {
                                <div class="list-group-item px-0 py-3">
                                    <div class="d-flex w-100 justify-content-between">
                                        <h5 class="mb-1 fw-bold text-primary">@duyuru.Baslik</h5>
                                        <small class="text-muted badge bg-light text-dark border">@duyuru.YayinTarihi.ToString("dd.MM.yyyy")</small>
                                    </div>
                                    <p class="mb-1 text-secondary mt-2">@duyuru.Icerik</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>