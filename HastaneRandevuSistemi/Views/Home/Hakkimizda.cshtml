@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="bg-primary text-white text-center py-5 mb-5 rounded-3 shadow-sm" style="background: linear-gradient(45deg, #0d6efd, #0dcaf0);">
    <h1 class="display-4 fw-bold">Hakkımızda</h1>
    <p class="lead">Sağlıkta güvenin ve şefkatin adresi.</p>
</div>

<div class="container">
    <div class="row align-items-center mb-5">
        <div class="col-md-6">

            <img src="~/img/hastane.jpg"
                 class="img-fluid rounded shadow"
                 alt="Hastane Binası"
                 onerror="this.onerror=null;this.src='https://via.placeholder.com/800x600?text=Hastane+Gorseli';">
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold text-primary">Tarihçemiz</h2>
            <p class="text-muted">
                2010 yılında "Önce İnsan" sloganıyla yola çıkan Özel Koçak Hastanesi, İstanbul'un kalbinde modern tıbbın tüm imkanlarını kullanarak hizmet vermeye başlamıştır.
                Küçük bir poliklinik olarak başladığımız bu yolculukta, bugün 50'den fazla uzman doktorumuz, 200 yatak kapasitemiz ve son teknoloji yoğun bakım ünitelerimizle
                bölgenin en kapsamlı sağlık kompleksi haline geldik.
            </p>
            <p class="text-muted">
                Hastalarımıza sadece tedavi değil, aynı zamanda huzurlu ve konforlu bir iyileşme süreci sunmayı hedefliyoruz.
            </p>
        </div>
    </div>

    <div class="row text-center mt-5">
        <div class="col-md-4">
            <div class="card border-0 h-100">
                <div class="card-body">
                    <i class="fas fa-bullseye fa-3x text-danger mb-3"></i>
                    <h4 class="fw-bold">Misyonumuz</h4>
                    <p class="text-muted">Etik değerlere bağlı kalarak, hasta haklarına saygılı, erişilebilir ve kaliteli sağlık hizmetini toplumun tüm kesimlerine ulaştırmak.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 h-100">
                <div class="card-body">
                    <i class="fas fa-eye fa-3x text-warning mb-3"></i>
                    <h4 class="fw-bold">Vizyonumuz</h4>
                    <p class="text-muted">Sağlık teknolojilerini yakından takip eden, uluslararası standartlarda referans gösterilen bir sağlık kuruluşu olmak.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 h-100">
                <div class="card-body">
                    <i class="fas fa-heart fa-3x text-success mb-3"></i>
                    <h4 class="fw-bold">Değerlerimiz</h4>
                    <p class="text-muted">Güven, Şefkat, Yenilikçilik, Takım Çalışması ve Mükemmeliyetçilik.</p>
                </div>
            </div>
        </div>
    </div>
</div>