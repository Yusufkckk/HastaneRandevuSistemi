@model HastaneRandevuSistemi.Models.Doktor

@{
    ViewData["Title"] = "Doktor Sil";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow border-0">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h5 class="m-0 fw-bold"><i class="fas fa-exclamation-triangle"></i> Silme Onayı</h5>
                </div>

                <div class="card-body p-4 text-center">
                    <h5 class="mb-4">Bu doktor kaydını silmek üzeresiniz.</h5>

                    <div class="bg-light p-3 rounded mb-4 border">
                        <h4 class="fw-bold text-dark">@Html.DisplayFor(model => model.Ad) @Html.DisplayFor(model => model.Soyad)</h4>
                        <p class="text-muted mb-0">@Html.DisplayFor(model => model.Departman.DepartmanAdi)</p>
                        <p class="text-muted small">@Html.DisplayFor(model => model.Email)</p>
                    </div>

                    <p class="text-danger small fw-bold">Bu işlem geri alınamaz!</p>

                    <form asp-action="DoktorSil" method="post">
                        <input type="hidden" asp-for="DoktorID" />

                        <div class="d-flex justify-content-center gap-3 mt-4">
                            <a asp-action="DoktorYonetimi" class="btn btn-secondary px-4">
                                Hayır, Vazgeç
                            </a>
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="fas fa-trash"></i> Evet, Sil
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>