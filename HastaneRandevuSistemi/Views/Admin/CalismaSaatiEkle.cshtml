@model HastaneRandevuSistemi.Models.CalismaSaatleri
@{
    ViewData["Title"] = "Çalışma Saati Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="m-0 font-weight-bold text-info"><i class="fas fa-calendar-alt"></i> Çalışma Saati Tanımla</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CalismaSaatiEkle">
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold text-muted small">DOKTOR</label>
                            <select asp-for="DoktorID" class="form-select"
                                    asp-items="@(new SelectList(ViewBag.Doktorlar, "DoktorID", "AdSoyad"))">
                                <option value="">-- Seçiniz --</option>
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Gun" class="form-label fw-bold text-muted small">GÜN</label>
                            <select asp-for="Gun" class="form-select">
                                <option value="1">Pazartesi</option>
                                <option value="2">Salı</option>
                                <option value="3">Çarşamba</option>
                                <option value="4">Perşembe</option>
                                <option value="5">Cuma</option>
                                <option value="6">Cumartesi</option>
                                <option value="0">Pazar</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 form-group mb-4">
                                <label asp-for="BaslangicSaati" class="form-label fw-bold text-muted small">BAŞLANGIÇ</label>
                                <input type="time" asp-for="BaslangicSaati" class="form-control" value="09:00" />
                            </div>
                            <div class="col-md-6 form-group mb-4">
                                <label asp-for="BitisSaati" class="form-label fw-bold text-muted small">BİTİŞ</label>
                                <input type="time" asp-for="BitisSaati" class="form-control" value="17:00" />
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-info text-white btn-lg shadow-sm">
                                <i class="fas fa-check"></i> Kaydet
                            </button>
                            <a asp-action="TakvimYonetimi" class="btn btn-light text-muted">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>