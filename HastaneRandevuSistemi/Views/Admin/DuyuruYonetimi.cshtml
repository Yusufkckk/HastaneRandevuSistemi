@model IEnumerable<HastaneRandevuSistemi.Models.Duyuru>
@{
    ViewData["Title"] = "Duyuru Yönetimi";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Duyuru Yönetimi</h2>
        <a asp-action="DuyuruEkle" class="btn btn-warning text-white shadow-sm">
            <i class="fa fa-plus"></i> Yeni Duyuru Ekle
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-warning">Duyuru Listesi</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light text-dark">
                        <tr>
                            <th style="width: 25%;">Başlık</th>
                            <th>İçerik</th>
                            <th style="width: 15%;">Yayın Tarihi</th>
                            <th style="width: 100px;" class="text-center">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.Baslik</td>
                                <td>
                                    @if (item.Icerik.Length > 80)
                                    {
                                        @item.Icerik.Substring(0, 80)

                                        <span class="text-muted">...</span>
                                    }
                                    else
                                    {
                                        @item.Icerik
                                    }
                                </td>
                                <td>@item.YayinTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-center align-middle">
                                    <a asp-action="DuyuruSil" asp-route-id="@item.DuyuruID"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">
                                        <i class="fa fa-trash"></i> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>