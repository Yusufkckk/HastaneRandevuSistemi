@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4">Admin Dashboard</h2>

<div class="row g-4 mb-5">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            TOPLAM DOKTOR
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.ToplamDoktor</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user-md fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            TOPLAM HASTA
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.ToplamHasta</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-user fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <a asp-action="TumRandevular" asp-controller="Admin" style="text-decoration: none; color: inherit;">
            <div class="card border-left-info shadow h-100 py-2 cursor-pointer">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                TOPLAM RANDEVU (Listele)
                            </div> <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.ToplamRandevu</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar-check fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </a>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="card border-left-warning shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                            TOPLAM DEPARTMAN
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.ToplamDepartman</div>
                    </div>
                    <div class="col-auto">
                        <i class="fas fa-building fa-2x text-gray-300"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<hr />

<hr class="my-5" />
<h4 class="mb-3 text-gray-800">Hızlı Erişim Menüsü</h4>

<div class="row g-4">

    <div class="col-xl-3 col-md-6">
        <div class="card shadow h-100 border-0 hover-scale">
            <div class="card-body text-center d-flex flex-column justify-content-center">
                <div class="mb-3">
                    <i class="fas fa-user-md fa-3x text-primary"></i>
                </div>
                <h5>Doktor Yönetimi</h5>
                <p class="text-muted small">Yeni doktor ekle veya düzenle.</p>
                <a asp-action="DoktorYonetimi" asp-controller="Admin" class="btn btn-primary mt-auto">Yönet</a>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow h-100 border-0">
            <div class="card-body text-center d-flex flex-column justify-content-center">
                <div class="mb-3">
                    <i class="fas fa-building fa-3x text-success"></i>
                </div>
                <h5>Departman Yönetimi</h5>
                <p class="text-muted small">Poliklinikleri düzenle.</p>
                <a asp-action="DepartmanYonetimi" asp-controller="Admin" class="btn btn-success mt-auto">Yönet</a>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow h-100 border-0">
            <div class="card-body text-center d-flex flex-column justify-content-center">
                <div class="mb-3">
                    <i class="fas fa-bullhorn fa-3x text-warning"></i>
                </div>
                <h5>Duyuru Yönetimi</h5>
                <p class="text-muted small">Ana sayfa duyurularını yönet.</p>
                <a asp-action="DuyuruYonetimi" asp-controller="Admin" class="btn btn-warning text-white mt-auto">Yönet</a>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card shadow h-100 border-0">
            <div class="card-body text-center d-flex flex-column justify-content-center">
                <div class="mb-3">
                    <i class="fas fa-clock fa-3x text-info"></i>
                </div>
                <h5>Takvim Yönetimi</h5>
                <p class="text-muted small">Çalışma saatlerini ayarla.</p>
                <a asp-action="TakvimYonetimi" asp-controller="Admin" class="btn btn-info text-white mt-auto">Yönet</a>
            </div>
        </div>
    </div>

</div>