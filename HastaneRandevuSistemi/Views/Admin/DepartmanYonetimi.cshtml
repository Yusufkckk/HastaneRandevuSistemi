@model IEnumerable<HastaneRandevuSistemi.Models.Departman>

@{
    ViewData["Title"] = "Departman Yönetimi";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Departman Yönetimi</h2>
        <a asp-action="DepartmanEkle" class="btn btn-success shadow-sm">
            <i class="fa fa-plus"></i> Yeni Departman Ekle
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">Poliklinik Listesi</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light text-dark">
                        <tr>
                            <th>Departman Adı</th>
                            <th style="width: 200px;" class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold ps-3">
                                    @Html.DisplayFor(modelItem => item.DepartmanAdi)
                                </td>
                                <td class="align-middle text-center">
                                    <div class="d-flex justify-content-center gap-2">

                                        <a asp-action="DepartmanDuzenle" asp-route-id="@item.DepartmanID" class="btn btn-primary btn-sm">
                                            <i class="fa fa-edit"></i> Düzenle
                                        </a>

                                        <a asp-action="DepartmanSil" asp-route-id="@item.DepartmanID" class="btn btn-danger btn-sm">
                                            <i class="fa fa-trash"></i> Sil
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>