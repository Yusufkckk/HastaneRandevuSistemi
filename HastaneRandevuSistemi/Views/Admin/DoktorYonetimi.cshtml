@model IEnumerable<HastaneRandevuSistemi.Models.Doktor>

@{
    ViewData["Title"] = "Doktor Yönetimi";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Doktor Yönetimi</h2>
        <a asp-action="DoktorEkle" class="btn btn-success shadow-sm">
            <i class="fa fa-plus"></i> Yeni Doktor Ekle
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-primary">Doktor Listesi</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0" width="100%" cellspacing="0">
                    <thead class="table-light text-dark">
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Email</th>
                            <th>Telefon</th>
                            <th>Departman</th>
                            <th style="width: 150px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold">
                                    @Html.DisplayFor(modelItem => item.Ad) @Html.DisplayFor(modelItem => item.Soyad)
                                </td>
                                <td class="align-middle">
                                    @Html.DisplayFor(modelItem => item.Email)
                                </td>
                                <td class="align-middle">
                                    @Html.DisplayFor(modelItem => item.Telefon)
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-info text-dark">@item.Departman.DepartmanAdi</span>
                                </td>
                                <td class="align-middle text-center">
                                    <a asp-action="DoktorDuzenle" asp-route-id="@item.DoktorID" class="btn btn-primary btn-sm">
                                        <i class="fa fa-edit"></i>
                                    </a>
                                    <a asp-action="DoktorSil" asp-route-id="@item.DoktorID" class="btn btn-danger btn-sm">
                                        <i class="fa fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>