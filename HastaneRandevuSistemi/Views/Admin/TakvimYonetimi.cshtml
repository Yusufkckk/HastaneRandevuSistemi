@model IEnumerable<HastaneRandevuSistemi.Models.CalismaSaatleri>
@{
    ViewData["Title"] = "Çalışma Saatleri";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Takvim Yönetimi</h2>
        <a asp-action="CalismaSaatiEkle" class="btn btn-info text-white shadow-sm">
            <i class="fa fa-clock"></i> Yeni Saat Ekle
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 bg-white">
            <h6 class="m-0 font-weight-bold text-info">Doktor Çalışma Saatleri</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0">
                    <thead class="table-light text-dark">
                        <tr>
                            <th>Doktor</th>
                            <th>Gün</th>
                            <th>Saat Aralığı</th>
                            <th style="width: 100px;" class="text-center">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle fw-bold">@item.Doktor.Ad @item.Doktor.Soyad</td>
                                <td class="align-middle">
                                    @switch (item.Gun)
                                    {
                                        case DayOfWeek.Monday:
                                            <span class="badge bg-primary">Pazartesi</span>
                                            ; break;
                                        case DayOfWeek.Tuesday:
                                            <span class="badge bg-primary">Salı</span>
                                            ; break;
                                        case DayOfWeek.Wednesday:
                                            <span class="badge bg-primary">Çarşamba</span>
                                            ; break;
                                        case DayOfWeek.Thursday:
                                            <span class="badge bg-primary">Perşembe</span>
                                            ; break;
                                        case DayOfWeek.Friday:
                                            <span class="badge bg-primary">Cuma</span>
                                            ; break;
                                        case DayOfWeek.Saturday:
                                            <span class="badge bg-warning text-dark">Cumartesi</span>
                                            ; break;
                                        case DayOfWeek.Sunday:
                                            <span class="badge bg-danger">Pazar</span>
                                            ; break;
                                    }
                                </td>
                                <td class="align-middle">
                                    <i class="far fa-clock text-muted"></i>
                                    @item.BaslangicSaati.ToString(@"hh\:mm") - @item.BitisSaati.ToString(@"hh\:mm")
                                </td>
                                <td class="align-middle text-center">
                                    <a asp-action="CalismaSaatiSil" asp-route-id="@item.CalismaSaatiID"
                                       class="btn btn-danger btn-sm"
                                       onclick="return confirm('Silmek istediğinize emin misiniz?');">
                                        <i class="fa fa-trash"></i> Sil
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>